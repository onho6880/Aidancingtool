# ========================================
# VidAI Studio - Cấu hình môi trường
# Copy file này thành .env.local và điền giá trị thực
# ========================================

# ── APP ──────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Thay bằng domain thực khi deploy, ví dụ: https://yourdomain.com
APP_SECRET=change_me_to_random_32_char_string

# ── AI PROVIDERS ────────────────────────
# Chọn provider chính: replicate | kling | runway
AI_PROVIDER_MOTION_COPY=replicate
AI_PROVIDER_IMAGE_TO_VIDEO=replicate
AI_PROVIDER_CLOTHES_CHANGE=replicate

# Replicate (https://replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kling AI - Kuaishou (https://klingai.com/dev - API còn beta)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# RunwayML (https://app.runwayml.com/settings)
RUNWAYML_API_SECRET=

# ── REPLICATE MODEL IDs ──────────────────
# Motion Copy: Animate character with reference motion
REPLICATE_MODEL_MOTION_COPY=lucataco/animate-anyone:a8a...
# Thay bằng model ID thực, ví dụ: fofr/stable-video-diffusion

# Image to Video: Convert static image to video
REPLICATE_MODEL_IMAGE_TO_VIDEO=stability-ai/stable-video-diffusion:3f0457e4619daac51203dedb472816fd4af51f3149fa7a9e0b5ffcf1b8172438

# Clothes Change: Virtual Try-On
REPLICATE_MODEL_CLOTHES_CHANGE=cuuupid/idm-vton:906425dbfd0b17b9df6ea3fcef058433cbaeefa7d24c37d0e5ab63b99de4b668

# ── STORAGE ──────────────────────────────
# Thư mục lưu file upload và kết quả (tuyệt đối hoặc tương đối với project root)
UPLOAD_DIR=./data/uploads
RESULTS_DIR=./data/results
MAX_FILE_SIZE_MB=100

# ── DATABASE ──────────────────────────────
DB_PATH=./data/db/vidai.db

# ── JOB WORKER ────────────────────────────
WORKER_POLL_INTERVAL_MS=5000
WORKER_MAX_CONCURRENT=3
JOB_TIMEOUT_MINUTES=30
